# Copy this file to backend/.env and replace every placeholder before deployment.
# Local Windows development uses PostgreSQL on localhost. Docker Compose
# overrides DATABASE_URL and REDIS_URL with its internal service addresses.
DATABASE_URL=postgresql+psycopg2://fleetflow_user:replace_me@localhost:5432/fleetflow_db
# Enable the Google Maps Routes API and billing for the Google Cloud project.
GOOGLE_MAPS_API_KEY=your_google_maps_routes_api_key
# Use redis://redis:6379/0 when running under Docker Compose.
REDIS_URL=redis://localhost:6379/0
# Generate a unique random value of at least 32 characters before deployment.
SECRET_KEY=replace_with_a_unique_random_secret_of_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated browser origins. Leave empty when FastAPI serves the bundled UI.
CORS_ORIGINS=
# Email role-change notices use MAIL_USERNAME, MAIL_PASSWORD and MAIL_FROM.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Optional SMS notices are sent through Twilio. Phone numbers must include
# their country code, for example +919876543210.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
