# Create backend/.env from this file and replace the placeholder with your key.
# Local Windows development uses PostgreSQL on localhost. Docker Compose
# overrides this value with its internal postgres service URL.
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/fleetflow_db
# Enable the Google Maps Routes API and billing for the Google Cloud project.
GOOGLE_MAPS_API_KEY=your_google_maps_routes_api_key
# Use redis://redis:6379/0 when running under Docker Compose.
REDIS_URL=redis://localhost:6379/0
# Replace this with a securely generated value before deployment.
SECRET_KEY=fleetflow-local-development-key-change-this-before-production
# Email role-change notices use MAIL_USERNAME, MAIL_PASSWORD and MAIL_FROM.
# Optional SMS notices are sent through Twilio. Phone numbers must include
# their country code, for example +919876543210.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
